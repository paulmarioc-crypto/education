# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string the APP uses at runtime. On Vercel with the Neon
# integration installed, this is set for you automatically — you never touch
# it. For local dev, point at a local Postgres instance.
DATABASE_URL="postgresql://postgres:password@localhost:5432/medstudy"

# Postgres connection string MIGRATIONS use (prisma migrate). Also
# auto-injected by Vercel's Neon integration. For local dev, same as
# DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:password@localhost:5432/medstudy"

# PIN used to unlock the app on any device. Pick something short but not
# "0000" — on a hosted deploy this is the only thing standing between
# anyone with the URL and your data.
MEDSTUDY_PIN="1234"

# Secret used to sign the login session cookie/JWT. Any long random string.
MEDSTUDY_SESSION_SECRET="change-me-to-a-long-random-string"

# Anthropic API key, for question/case generation, chat, and mistake analysis.
ANTHROPIC_API_KEY=""

# Port the server listens on.
PORT=4000
