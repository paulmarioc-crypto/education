# Copy this file to .env and fill in real values. .env is gitignored.

# SQLite file location (relative to server/prisma/, where prisma resolves it from)
DATABASE_URL="file:./data/medstudy.db"

# PIN used to unlock the app on any device on your network. Pick something
# short but not "0000" — this is the only thing standing between anyone on
# your LAN and your data.
MEDSTUDY_PIN="1234"

# Secret used to sign the login session cookie/JWT. Any long random string.
MEDSTUDY_SESSION_SECRET="change-me-to-a-long-random-string"

# Anthropic API key, for question/case generation, chat, and mistake analysis.
ANTHROPIC_API_KEY=""

# Port the server listens on. Bind is 0.0.0.0 so your phone/tablet can reach
# it at http://<your-computer's-LAN-IP>:PORT
PORT=4000
