# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string the APP uses at runtime. For local dev, a plain
# local Postgres instance. For Neon: the "Pooled connection" string from your
# Neon dashboard (hostname contains "-pooler").
DATABASE_URL="postgresql://postgres:password@localhost:5432/medstudy"

# Postgres connection string MIGRATIONS use (prisma migrate). For local dev,
# same as DATABASE_URL. For Neon: the "Direct connection" string (no
# "-pooler" in the hostname) — migrations fail against the pooled one.
DIRECT_URL="postgresql://postgres:password@localhost:5432/medstudy"

# PIN used to unlock the app on any device. Pick something short but not
# "0000" — on a hosted deploy this is the only thing standing between
# anyone with the URL and your data.
MEDSTUDY_PIN="1234"

# Secret used to sign the login session cookie/JWT. Any long random string.
MEDSTUDY_SESSION_SECRET="change-me-to-a-long-random-string"

# Anthropic API key, for question/case generation, chat, and mistake analysis.
ANTHROPIC_API_KEY=""

# Port the server listens on.
PORT=4000
